    <string name="about_title">À propos de l’application</string>
    <string name="about_text">Noise Meter est une application développée indépendamment pour le suivi pratique du niveau de bruit ambiant. L’application est améliorée en continu grâce aux retours des utilisateurs.</string>
    <string name="about_support_button">Soutenir le développement</string>
